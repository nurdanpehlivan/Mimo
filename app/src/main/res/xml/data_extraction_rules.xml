<?xml version="1.0" encoding="utf-8"?>
<!--
  Yedekleme kuralları (Android 12 ve üstü).

  Logio'nun hiçbir verisi Google Drive yedeğine ya da telefondan telefona aktarıma GİRMEZ:
  - Günlük veritabanı şifrelidir ve anahtarı telefonun donanımında (Android Keystore) durur;
    yeni telefona taşınsa bile açılamaz, işe yaramaz.
  - Fotoğraf, ses ve video dosyaları şifresizdir; yedeğe girerlerse "veriler cihazdan çıkmaz" sözü bozulur.
  Android 12+ cihazlarda allowBackup="false" telefondan telefona aktarımı durdurmadığı için
  her iki bölümde de bütün alanlar tek tek hariç tutulur.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
